# Generated active-theme / gui-size symlinks — created by install.sh (and
# flipped by the `theme` script). The tracked sources are the -dark/-light
# variants; the active symlink is machine state, not source.
/config/eww/eww.scss
/config/hypr/border-colors.conf
/config/rofi/colorScheme.rasi
/config/rofi/guiSize.rasi
/config/swaync/style.css
/config/gtk-3.0/settings.ini
/config/gtk-3.0/gtk.css

# Per-machine overrides — seeded from *.example by install.sh, then yours to
# edit. Keeps the tracked base config byte-identical for everyone.
/config/hypr/local.conf
/config/hypr/window-policy.local.conf
/config/eww/local.yuck
/config/saneland/theme.local.sh

# Whole-file overlay tree (your private tweaks; can be its own repo). Only the
# README is tracked — everything you drop in is git-ignored. See CUSTOMIZING.md.
/local/*
!/local/README.md

# User-supplied wallpaper images (drop your own in, or run wallpaper-fetch —
# see wallpapers/README.md). No imagery is ever tracked here: it is someone
# else's copyright, and the pools are machine state, not source.
/wallpapers/dark/*
/wallpapers/dusk/*
/wallpapers/dawn/*
/wallpapers/light/*
!/wallpapers/*/.gitkeep
# Credits for whatever wallpaper-fetch pulled down — describes your local pool,
# so it follows the images rather than the repo.
/wallpapers/ATTRIBUTION.md
# Perceptual fingerprints of the local pool, so re-runs don't re-add near-copies.
# Pure cache, rebuilt from the images on demand.
/wallpapers/.wallpaper-hashes
# Ledger of every image ever fetched, so deleting one you disliked makes it stay
# gone. Not a cache — losing this lets rejects come back.
/wallpapers/.wallpaper-seen

# OS / editor cruft
*.swp
*~
.DS_Store
