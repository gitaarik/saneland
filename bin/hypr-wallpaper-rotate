#!/usr/bin/bash
#
# Rotate the wallpaper within the current theme's pool on a timer.
#
# Started once from hyprland.conf's exec-once. Every $INTERVAL it asks
# hypr-wallpaper to pick a fresh image from whatever theme is active at that
# moment (~/.cache/current-theme), so it follows dark/light switches with no
# extra wiring. The first iteration also paints the initial wallpaper at login.
#
# Change the cadence here (sleep(1) suffixes: 45m, 1h, 90s, ...):
INTERVAL=30m
#
# `hypr-wallpaper-rotate next` (bound to mod+b) jumps to the next image
# immediately and restarts the interval from there, so a manual change isn't
# followed by an automatic one seconds later.

run="${XDG_RUNTIME_DIR:-/tmp}/hypr-wallpaper-rotate"

# `next` — nudge the running loop with SIGUSR1. It has to find the loop by PID
# file: comm(2) truncates at 15 characters (so `pkill -x hypr-wallpaper-rotate`
# never matches) and `pkill -f` would match this process too. The /proc check
# guards against a stale PID that the kernel has since recycled onto something
# innocent. With no loop running at all, just paint once directly.
if [[ ${1:-} == next ]]; then
    pid=$(cat "$run.pid" 2>/dev/null)
    if [[ -n $pid && $(cat "/proc/$pid/comm" 2>/dev/null) == hypr-wallpaper-* ]]; then
        kill -USR1 "$pid"
    else
        ~/.local/bin/hypr-wallpaper
    fi
    exit
fi

# Singleton: if a rotator is already running (e.g. a leftover from a previous
# Hyprland instance, or a manual re-run) bail out. The lock auto-releases when
# the holding process dies, so a crashed rotator won't block the next login.
exec 9>"$run.lock" || exit 0
flock -n 9 || exit 0

echo $$ > "$run.pid"

# Repaint whenever a monitor is connected. awww-daemon notices the new output
# and gives it a surface, but never puts an image on it — `awww img` only
# reaches the monitors that exist when it runs — so the screen comes up showing
# Hyprland's own built-in wallpaper instead. `repaint` re-applies the CURRENT
# image rather than picking a new one: plugging in a screen shouldn't reshuffle
# the one you were already looking at.
#
# Same socket2 + ncat pattern as eww-bars.sh --watch, in the `exec 3<` form so
# the loop is killable (see the "killable event loops" note in
# docs/ARCHITECTURE.md). The short sleep lets Hyprland finish bringing the
# output up before we paint it. Runs as a background job so the timer below
# keeps its own schedule — a hot-plug is not a rotation tick.
watch_monitors() {
    local sock line ncat_pid
    sock=${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr/${HYPRLAND_INSTANCE_SIGNATURE:-}/.socket2.sock
    exec 3< <(ncat -U "$sock" 2>/dev/null)
    ncat_pid=$!
    trap 'kill "$ncat_pid" 2>/dev/null' EXIT
    trap 'exit' INT TERM

    while IFS= read -r line <&3; do
        case "$line" in
            # Hyprland fires BOTH monitoradded>>NAME and monitoraddedv2>>id,NAME,desc
            # for one plug — anchoring on `>>` takes the v1 form only, so we
            # don't paint the same image twice per connect.
            monitoradded'>>'*)
                sleep 0.5
                ~/.local/bin/hypr-wallpaper repaint
                ;;
        esac
    done
}

watch_monitors 9>&- &
watcher_pid=$!
trap 'kill "$watcher_pid" 2>/dev/null' EXIT

# The wait is a backgrounded sleep rather than a plain one so SIGUSR1 can cut
# it short: bash runs the handler as soon as `wait` is interrupted, and the
# loop then falls straight into the next paint.
sleep_pid=
trap '[[ -n $sleep_pid ]] && kill "$sleep_pid" 2>/dev/null' USR1

# `9>&-` on both children: bash doesn't set close-on-exec on fd 9, so a sleep
# that outlives us (Hyprland exits, the shell is killed) would keep holding the
# flock as an orphan — and the next login's rotator would find the lock taken
# and quietly give up for the rest of the interval.
while true; do
    ~/.local/bin/hypr-wallpaper 9>&-
    sleep "$INTERVAL" 9>&- &
    sleep_pid=$!
    wait "$sleep_pid" 2>/dev/null
done
