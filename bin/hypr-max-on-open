#!/usr/bin/env bash
#
# Listen for Hyprland window events and:
#
#   - On open: restore the window's last saved geometry for its class ON THE
#     SCREEN IT OPENED ON (KWin-style "remember window size/position", per
#     monitor). With nothing remembered yet, the window is maximized only if
#     the auto-maximize policy says `always` for its class:
#       1. policy `never`    -> don't touch it at all
#       2. not the only window of its class -> don't touch it at all
#                               (THE ONE RULE, below)
#       3. remembered geometry, if any — it wins over the policy. This
#                               screen's entry if there is one, else the
#                               newest entry from any screen, re-read for this
#                               one by reanchor_axis
#       4. policy `always`   -> maximize
#     Anything else keeps the size it asked for. The policy lives in
#     ~/.config/hypr/window-policy.conf (+ .local.conf); read the header
#     there for why "unlisted" means leave alone rather than guess.
#     Whatever geometry comes out of that is then RE-ASSERTED until the
#     client actually holds it — see apply_and_settle; a window that is
#     still sizing itself will otherwise pocket half of what we asked for.
#
#   - On resize: persist the new geometry once it has held still for two
#     poll ticks, so a mod+c or a drag-resize sticks immediately instead of
#     only at close time. Hyprland's event socket has no resize event, so
#     the clients poll below doubles as the change detector. Changes in the
#     first few seconds after a monitor is added or removed are adopted
#     silently instead — that is Hyprland reshuffling outputs, not you.
#
#   - On close: save the window's geometry to a per-class file at
#     ~/.cache/hypr-window-state/<class>.json — under the name of the monitor
#     it was on, leaving the other screens' entries untouched — if it was the
#     last window of its class. Any size is saved, snaps included (50% on an
#     axis), because a geometry you arranged by hand is exactly what this is
#     for; the last-of-class gate is what keeps a dialog from overwriting it.
#
#   - On fullscreen>>1: if a client maximized *itself* (a GTK/GNOME
#     client-side-decoration maximize button -> set_maximized), reroute it
#     to the same stateless work-area maximize mod+m uses, so app-maximize
#     and mod+m look and behave identically instead of being two separate
#     actions. Real fullscreen (mod+Shift+m, or an app's own F11) is left
#     untouched.
#
#   - On move to another screen: a window that was filling — or snapped to
#     a half or quarter of — the screen it came from is given the same
#     rectangle of the new one. Moving a window does not resize it, so it
#     arrives wearing the old screen's pixels: a hole around it on a bigger
#     screen, hanging off the edges on a smaller one. Needs no bookkeeping
#     to spot, because both are GEOMETRIES and not states — "maximized" IS
#     a screen's work area (hypr_fills_work_area) and a snap IS half of one
#     (hypr_snap_axes), so a window wearing some OTHER connected screen's
#     rectangle was in that state there a moment ago.
#
# THE ONE RULE: everything automatic above — the restore, the maximize, and the
# saving — applies only to a window that is the ONLY ONE OF ITS CLASS at that
# moment (alone_of_class). A second window of an app is a dialog far more often
# than it is a second main window: GIMP's Preferences and Export As,
# Thunderbird's event details, a browser's Picture-in-Picture and Library. There
# is no way to ask a Wayland client which it is — hyprctl exposes no parent
# window, no window type and no size hints, and xdgTag/xdgDescription/
# contentType are empty on every real client here (0.55.4) — so this one rule
# replaces the two mechanisms that used to guess: a per-app title classifier
# that needed a new arm for every app, and a "did it open at >= 60% of the work
# area" size test that a large dialog sails straight through.
#
# What it costs: a second window of an app that doesn't remember its own size
# opens small. mod+m fixes that window, and mod+Alt+Shift+m
# (hypr-window-policy remember) records a geometry for the class deliberately,
# for when the automatic save can't see it. Nothing you do by hand is gated —
# mod+m, mod+c, the snaps, an app's own maximize button and moving a window
# between screens all act on whatever window you point them at.
#
# Hyprland's closewindow event arrives after the window is dropped
# from `hyprctl clients`, so a background loop snapshots clients to
# a cache file every 2s and the close handler looks the window up
# there.
#
# To reset persisted geometry for an app: rm ~/.cache/hypr-window-state/<class>.json

set -uo pipefail
source "${HOME}/.local/bin/hypr-window-lib.sh"

sock=${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr/${HYPRLAND_INSTANCE_SIGNATURE:-}/.socket2.sock

if [[ ! -S $sock ]]; then
    echo "hypr-max-on-open: Hyprland event socket not found: $sock" >&2
    exit 1
fi

state_dir=$HYPR_STATE_DIR          # set by hypr-window-lib.sh, which also owns
cache_file=$state_dir/clients-cache.json   # the per-class geometry files in it
mkdir -p "$state_dir"

# Short-lived per-address markers so the fullscreen>>1 handler can tell
# "user maximized a running window" (reroute it) from "window maximized
# itself as it opened" (already owned by the openwindow branch — leave it).
grace_dir=$state_dir/opening
mkdir -p "$grace_dir"

# Touched by the monitoradded/monitorremoved handler. Unplug an output and
# Hyprland moves every workspace on it to a surviving screen, resizing the
# windows to fit — none of which is a choice you made, but all of which looks
# exactly like a resize to the poller below. Left alone it overwrites the
# remembered geometry of every window that got shuffled: measured on a dock
# cycle, kitty and Telegram lost their half-screen snaps on the second monitor
# and came back remembered as full-screen on the laptop.
settle_file=$state_dir/monitors-settling
monitor_settle_secs=5

# True while Hyprland is still rearranging after a monitor came or went.
monitors_settling() {
    local now mtime
    [[ -e $settle_file ]] || return 1
    mtime=$(stat -c %Y "$settle_file" 2>/dev/null) || return 1
    now=${EPOCHSECONDS:-$(date +%s)}
    (( now - mtime < monitor_settle_secs ))
}

# Is a moved window's centre on the near side of an axis (left / top) rather
# than the far one (right / bottom)?
#
#   $1 the centre, RELATIVE to the destination work area's origin
#   $2 the source screen's extent on this axis
#   $3 the destination's extent
#
# Measured on this machine: Hyprland re-places a floating window at the same
# offset into the new monitor and clamps it inward when it no longer fits, so
# there are two cases, and the smaller of the two extents picks the right
# midline for both. Moving to a BIGGER screen keeps the offset exactly, so the
# centre is still the source's and the source's midline is what it must be
# judged against. Moving to a SMALLER one may clamp, which pushes the window
# hard against the very edge it was snapped to — so the destination's midline is
# the one that answers, and it is also the smaller.
#
# What it cannot tell apart: a window WIDER (or taller) than the whole
# destination work area, where a left and a right half both clamp to the same
# pixels. That needs one screen to be roughly twice the other on that axis.
near_side() {
    local mid=$(( ($2 < $3 ? $2 : $3) / 2 ))
    (( $1 < mid ))
}

# Which classes may be maximized is data, not code: hypr_policy_for (in
# hypr-window-lib.sh) reads ~/.config/hypr/window-policy{,.local}.conf and
# answers always | leave | never. The two regexes that used to live here are
# rules in those files now — `never ^Tor Browser$`, and `leave` for the
# blueman/pavucontrol dialogs that hyprland.conf sizes with a windowrule.

# Is the window at address $2 the only window of class $1 right now?
#
# THE ONE RULE (see the header) in one query. Both sides of the daemon use it,
# and the address is EXCLUDED rather than counted, so it reads the same at
# either end: at open time the new window is already in the client list, and at
# close time the closing one usually still is — closewindow arrives before
# Hyprland drops it, which is why the close handler can look it up live at all.
#
# The question is therefore always "does this app have another window open",
# and no answer at all (hyprctl unreachable) counts as yes: leave it alone.
alone_of_class() {
    local others
    others=$(hyprctl -j clients 2>/dev/null | jq --arg c "$1" --arg a "$2" \
        '[.[] | select(.class == $c and .address != $a)] | length' 2>/dev/null)
    [[ $others =~ ^[0-9]+$ ]] && (( others == 0 ))
}

# How close a window has to land to count as "the geometry took" (px). A few
# px of slack absorbs fractional-scale rounding.
geom_tolerance=4

# How close an edge has to be to a work-area boundary or midline to count as
# sitting ON it, when re-reading a geometry for a different-sized screen.
# Bigger than geom_tolerance because hypr-snap-window insets a snap by its 3px
# border on every side: a half is work_w/2 - 6 wide and a snapped full height
# is work_h - 6, both of which still mean "half" and "full".
edge_tolerance=8

# Re-express one axis of a saved geometry (extent $1 at offset $2, measured in
# a work area of $3) for a work area of $4. Prints "<extent> <offset>".
#
# The saved numbers are pixels, but what they MEANT is a relationship to the
# screen — filling it, half of it, centred in it. Pixels don't survive the trip
# to another monitor; the relationship does. So each edge is matched against
# the boundaries and the midline, and when both edges land on one the geometry
# is rebuilt from the new screen's equivalents, keeping whatever inset it had
# (which is what reproduces hypr-snap-window's 3px border exactly).
#
# An edge that matches nothing means a size you dialled in by hand, and that IS
# meant literally — a window you shrank to 900px wants to be 900px wide on the
# 4K screen too, not 60% of it. Only the position is remapped, proportionally
# to the free space around it, so a centred window stays centred and one parked
# against an edge stays there.
reanchor_axis() {
    awk -v s="$1" -v p="$2" -v A="$3" -v B="$4" -v tol="$edge_tolerance" '
        # Map an old coordinate onto the new work area, or set ok=0 if it is
        # not on a boundary/midline. Returns the new coordinate.
        function edge(v,   d) {
            ok = 1
            if (v <= tol) return v                                  # start
            d = A - v;     if (d <= tol && d >= -tol) return B - d   # end
            d = v - A / 2; if (d <= tol && d >= -tol) return B / 2 + d
            ok = 0
            return 0
        }
        BEGIN {
            a = edge(p);     oka = ok
            b = edge(p + s); okb = ok
            if (oka && okb && b - a >= 1) {
                np = a; ns = b - a
            } else {
                ns = (s < B ? s : B)
                np = (A - s > 0) ? p * (B - ns) / (A - s) : 0
            }
            if (np < 0) np = 0
            if (np + ns > B) np = B - ns
            printf "%d %d\n", int(ns + 0.5), int(np + 0.5)
        }'
}

# When to re-check after applying a geometry, in seconds. Cumulative ~2.4s
# worst case, but the loop stops at the first check that matches — a client
# that simply obeys costs one extra `hyprctl clients` at 0.15s.
geom_retry_delays=(0.15 0.35 0.7 1.2)

# Apply a geometry and keep re-applying until it sticks. Returns 0 once the
# window matches (or has closed), 1 if it never did.
#
# A window is still negotiating its own size for a moment after it maps, and
# applying a geometry into the middle of that quietly loses. Under xdg-shell a
# configure for a window that is neither maximized nor fullscreen is a
# SUGGESTION — a client may commit whatever size it likes — so a browser that
# is mid-startup just carries on to the size it had in mind. Firefox-family
# browsers restore `sizemode=maximized` plus a stored size from their profile
# and grow through several sizes in the first ~250ms:
#
#   openwindow                    (t+0)
#    506x424 -> 756x424           the browser sizing itself
#    asked for 1440x930           our apply lands mid-flight
#   -> 1190x930                   height kept, width discarded. Final.
#
# The height survives because the client had finished with that axis; the width
# is whatever the client was still heading for. That is the "comes back
# maximized in height but not width" bug, and it's why one shot isn't enough.
#
# The retries double as the refusal test: a client that will NEVER comply (a
# fixed-size dialog, min_size == max_size) still doesn't match after the last
# attempt — that's the 1 that maximize_checked learns from. Waiting it out this
# way is what keeps a slow-starting app from being mistaken for a fixed one.
apply_and_settle() {
    local addr=$1 w=$2 h=$3 x=$4 y=$5 d cw ch dw dh
    hypr_apply_geom "$addr" "$w" "$h" "$x" "$y" || return 1
    for d in "${geom_retry_delays[@]}"; do
        sleep "$d"
        read -r cw ch < <(hyprctl -j clients 2>/dev/null | jq -r --arg a "$addr" \
            '.[] | select(.address == $a) | "\(.size[0]) \(.size[1])"')
        [[ -z ${cw:-} || $cw == null ]] && return 0      # closed again already
        dw=$(( cw - w )); dh=$(( ch - h ))
        (( ${dw#-} <= geom_tolerance && ${dh#-} <= geom_tolerance )) && return 0
        hypr_apply_geom "$addr" "$w" "$h" "$x" "$y"
    done
    return 1
}

# Guess the work area a v2 geometry was saved in, given its size. Prints
# "<width> <height>", or "0 0" if nothing fits.
#
# A v2 entry records no monitor, so on its own it can only be taken literally —
# and a class that is never re-saved stays that way forever. Saving is gated on
# last-of-class, so a terminal or a chat app you always keep one window of is
# never written again and never upgrades: kitty sat at v2 1440x930 and kept
# opening laptop-sized on the Dell long after the browser had sorted itself out.
#
# A geometry must have FIT on the screen it was saved on, so the smallest
# connected work area it fits in is the best candidate — and for the case that
# actually matters, something saved filling its screen, it is exact: a
# maximized-on-the-Dell 1920x1050 doesn't fit the laptop at all. The guess can
# be wrong for a window that merely happens to be laptop-sized on the Dell, and
# that is fine: it is one-time legacy data, replaced by a real v3 entry the
# first time the window is saved.
infer_work_area() {
    local w=$1 h=$2 id best_w=0 best_h=0
    while read -r id; do
        hypr_work_area "$id" || continue
        (( WORK_W < w || WORK_H < h )) && continue
        (( best_w == 0 || WORK_W * WORK_H < best_w * best_h )) \
            && { best_w=$WORK_W; best_h=$WORK_H; }
    done < <(hyprctl -j monitors 2>/dev/null | jq -r '.[].id')
    printf '%d %d\n' "$best_w" "$best_h"
}

# Try to apply previously saved geometry for the given class. Returns
# 0 on success, 1 if there's no usable saved file (or class is denied).
apply_saved_geometry() {
    local class=$1 addr=$2 saved
    saved=$(hypr_geom_file "$class")
    [[ -f $saved ]] || return 1

    # The monitor comes first now: which entry we want depends on which screen
    # the window opened on. (WORK_MON is set by hypr_work_area.)
    hypr_work_area_for "$addr" || return 1

    # This screen's own entry, else the one saved most recently on any screen,
    # else a v2 file's single geometry. aw/ah default to 0, meaning "no idea
    # what screen this came from" — take it literally, as v2 always did.
    local entry w h x y aw ah
    entry=$(jq -r --arg mon "$WORK_MON" '
        (if   (.v? // 0) == 3 then (.mons[$mon] // .mons[.last // ""] // empty)
         elif (.v? // 0) == 2 then {width, height, x, y}
         else empty end)
        | select((.width | type) == "number" and (.height | type) == "number"
                 and (.x | type) == "number" and (.y | type) == "number")
        | [.width, .height, .x, .y, (.aw // 0), (.ah // 0)] | @tsv' \
        "$saved" 2>/dev/null)
    [[ -z $entry ]] && return 1
    IFS=$'\t' read -r w h x y aw ah <<<"$entry"

    # aw/ah of 0 means a v2 entry: no screen recorded, so work out which one it
    # must have been. (hypr_work_area clobbers WORK_*, hence the subshell.)
    if (( aw == 0 || ah == 0 )); then
        read -r aw ah < <(infer_work_area "$w" "$h")
    fi

    # Saved on a screen of a different size — read it as what it meant there
    # (filled it, half of it, centred in it) rather than as raw pixels.
    if (( aw > 0 && ah > 0 )) && (( aw != WORK_W || ah != WORK_H )); then
        read -r w x < <(reanchor_axis "$w" "$x" "$aw" "$WORK_W")
        read -r h y < <(reanchor_axis "$h" "$y" "$ah" "$WORK_H")
    fi

    # Clamp to fit: a v2 geometry saved maximized on the 4K output would
    # otherwise come back 3840px wide on a 1440px-wide laptop.
    (( w > WORK_W )) && w=$WORK_W
    (( h > WORK_H )) && h=$WORK_H
    (( x < 0 )) && x=0
    (( y < 0 )) && y=0
    (( x + w > WORK_W )) && x=$(( WORK_W - w ))
    (( y + h > WORK_H )) && y=$(( WORK_H - h ))

    # hypr_apply_geom (inside apply_and_settle) picks the border to match the
    # restored size: a window saved at work-area size (a main window like a
    # browser, which is saved maximized) comes back borderless, instead of
    # wearing a stray active-border around an otherwise-maximized frame.
    #
    # Always report success: the question this function answers is "was there a
    # remembered geometry for this class", and there was. Whether the client
    # could be talked all the way into it is a separate matter — returning 1
    # here would send an `always` class on to maximize_checked and blow away the
    # remembered size we just restored.
    apply_and_settle "$addr" "$w" "$h" "$(( WORK_X + x ))" "$(( WORK_Y + y ))"
    return 0
}

# Maximize, then check that it actually took.
#
# A window with fixed size constraints — a GTK dialog built with
# resizable=false, so min_size == max_size — silently keeps its own size, and
# Hyprland reports the client's real geometry rather than the box we asked
# for. (Measured: a zenity dialog stays 300x226 through a full work-area
# resize.) The window ends up right either way, but it flashes on the way,
# and there is no point repeating that on every single open. So record the
# class as `leave` and stop trying.
#
# It will not overwrite a rule you wrote yourself — see policy_learn.
maximize_checked() {
    local class=$1 addr=$2 w h aw ah ax ay
    hypr_work_area_for "$addr" || return 1
    aw=$WORK_W ah=$WORK_H ax=$WORK_X ay=$WORK_Y

    # Same geometry and chrome hypr_set_max applies (hypr_apply_geom picks the
    # `max` look at exactly work-area size), but re-asserted until it holds.
    apply_and_settle "$addr" "$aw" "$ah" "$ax" "$ay" && return 0

    # Every retry used up and it still isn't there. A client that was merely
    # slow to start has long since caught up by now, so this one means it —
    # but only treat a SUBSTANTIALLY smaller window as a refusal, or an app
    # that lands a few px short would demote itself over nothing.
    read -r w h < <(hyprctl -j clients 2>/dev/null | jq -r --arg a "$addr" \
        '.[] | select(.address == $a) | "\(.size[0]) \(.size[1])"')
    [[ -z ${w:-} || $w == null ]] && return 0        # closed again already
    if (( w * 10 < aw * 9 || h * 10 < ah * 9 )); then
        policy_learn "$class" "kept ${w}x${h} of ${aw}x${ah}"
    fi
}

# Demote a class to `leave` in the local policy file. Only ever writes when
# the class has no rule of its own there: an explicit choice of yours — set by
# hand or with mod+Alt+m — outranks anything the daemon infers, even when that
# means it keeps trying and failing. Family patterns in the tracked file are
# fair game, which is the case this exists for: one app inside `always
# ^(signal|element|discord|…)$` that can't be resized.
policy_learn() {
    local class=$1 why=$2 re
    re=$(hypr_policy_regex "$class")
    # Compare rule text literally — the rule IS a regex, so grepping for it
    # would match on its own metacharacters rather than on the class.
    if [[ -r $HYPR_POLICY_LOCAL ]] && awk -v re="$re" '
            { l = $0; sub(/[[:space:]]#.*$/, "", l) }
            l ~ /^[[:space:]]*(always|leave|never)[[:space:]]/ {
                sub(/^[[:space:]]*[a-z]+[[:space:]]+/, "", l)
                sub(/[[:space:]]+$/, "", l)
                if (l == re) { found = 1; exit }
            }
            END { exit !found }
        ' "$HYPR_POLICY_LOCAL"; then
        return 0
    fi
    mkdir -p "$(dirname "$HYPR_POLICY_LOCAL")"
    printf 'leave   %-40s # learned: refused maximize, %s\n' "$re" "$why" \
        >> "$HYPR_POLICY_LOCAL"
}

# Persist a geometry observed by the poller below. Same gate as the close-time
# save — the app's only window — so a GIMP dialog or a Thunderbird event-details
# popup can't overwrite the real window's size just by being dragged around.
#
# $count is the number of windows of this class, straight out of the poller's
# own snapshot, so this costs no extra hyprctl call; alone_of_class asks the
# same question at the two ends where there is no snapshot to hand.
persist_geometry() {
    local class=$1 geom=$2 mon=$3 count=$4
    [[ $(hypr_policy_for "$class") == never ]] && return 0
    (( count <= 1 )) || return 0
    local wh=${geom%%+*} xy=${geom#*+}         # WxH+X+Y, X may be negative
    hypr_save_geometry "$class" "${wh%%x*}" "${wh##*x}" "${xy%%+*}" "${xy##*+}" "$mon"
}

# Background poller. Two jobs:
#
#   1. Refresh the clients cache every 2s, so the closewindow handler has
#      something to look up after Hyprland has already dropped the window.
#
#   2. Notice geometry changes and persist them, so a mod+c or a drag-resize
#      sticks straight away instead of only when the window closes. Hyprland's
#      event socket has no resize event — polling is the only way to see one.
#
# A change is written only after it has held still for two consecutive ticks
# (~4s), so a drag in progress or a quick mod+m there-and-back isn't recorded.
# The first sighting of a window is its baseline, so a window you never touch
# is never written from here — it still goes through the close-time path with
# its last-of-class gate. Changes while the monitors are settling are adopted
# as the new baseline without being written, so a hotplug can't launder
# Hyprland's reshuffling into a preference of yours. Addresses are pruned every
# tick; a long uptime would otherwise accumulate an entry per window ever
# opened.
(
    declare -A base pend cur
    while sleep 2; do
        snap=$(hyprctl -j clients 2>/dev/null) || continue
        printf '%s' "$snap" > "$cache_file.tmp" && mv "$cache_file.tmp" "$cache_file"

        settling=0
        monitors_settling && settling=1        # once per tick, not per window

        cur=()
        while IFS=$'\t' read -r a cls geom mon count; do
            [[ -z $a ]] && continue
            cur[$a]=1
            if [[ -z ${base[$a]:-} ]]; then base[$a]=$geom; continue; fi
            # Adopt silently: whatever Hyprland just did to this window becomes
            # the baseline, so nothing is written now AND nothing is written
            # once the settle window closes either.
            if (( settling )); then base[$a]=$geom; unset 'pend[$a]'; continue; fi
            if [[ $geom == "${base[$a]}" ]]; then unset 'pend[$a]'; continue; fi
            if [[ ${pend[$a]:-} != "$geom" ]]; then pend[$a]=$geom; continue; fi
            base[$a]=$geom
            unset 'pend[$a]'
            persist_geometry "$cls" "$geom" "$mon" "$count"
        done < <(jq -r '
            (map(.class) | group_by(.) | map({key: .[0], value: length}) | from_entries) as $n
            | .[] | [ .address, .class,
                      "\(.size[0])x\(.size[1])+\(.at[0])+\(.at[1])",
                      .monitor, $n[.class] ] | @tsv' <<<"$snap")

        for a in "${!base[@]}"; do
            [[ -n ${cur[$a]:-} ]] || unset 'base[$a]' 'pend[$a]'
        done
    done
) &
poller_pid=$!

# Read the event stream over fd 3 instead of piping it into `while`. Bash defers
# a signal trap until the current foreground command finishes, and a pipeline of
# external commands never gets interrupted — so `kill <daemon>` did nothing at
# all (it took kill -9, or killing the whole process group so that ncat got the
# signal too and the pipeline ended on its own). Reading from a fd leaves the
# shell blocked in the `read` BUILTIN, which a signal does interrupt. It also
# runs the loop in this shell rather than a pipeline subshell, so there is one
# process fewer to lose track of.
exec 3< <(ncat -U "$sock")
ncat_pid=$!

# Two traps, not one on EXIT INT TERM: a signal trap that does not exit simply
# resumes the script. `exit` here re-triggers the EXIT trap, which is the one
# that reaps the children.
trap 'kill $poller_pid $ncat_pid 2>/dev/null' EXIT
trap 'exit' INT TERM

while IFS= read -r line <&3; do
    case "$line" in
        openwindow*)
            # Format: openwindow>>ADDRESS,WORKSPACE,CLASS,TITLE. Only the class
            # is used: the title said nothing reliable about main-vs-dialog
            # without a per-app rule for it, which is what THE ONE RULE
            # replaces (see the header).
            data=${line#openwindow>>}
            addr=${data%%,*}
            rest=${data#*,}                        # WORKSPACE,CLASS,TITLE
            class=${rest#*,}                       # CLASS,TITLE
            class=${class%%,*}
            addr_full="0x${addr}"

            # Mark as freshly opened so a self-maximize-on-open (Thunderbird
            # popups) isn't re-handled by the fullscreen branch. Cleared after
            # 2s so a genuine user maximize later on is not suppressed.
            touch "$grace_dir/$addr_full"
            ( sleep 2; rm -f "$grace_dir/$addr_full" ) &

            verdict=$(hypr_policy_for "$class")
            [[ $verdict == never ]] && continue

            (
                sleep 0.05

                # The app already has a window open, so this one is a dialog
                # far more often than it is a second main window — and there is
                # no way to tell the two apart. Leave it exactly as it asked to
                # be: GIMP's Export As and Preferences, Thunderbird's event
                # details, a browser's Picture-in-Picture and Library all land
                # here. mod+m if you disagree with one.
                alone_of_class "$class" "$addr_full" || exit 0

                # A remembered size beats the policy — it is a decision you
                # already made about this exact class, on this exact screen.
                apply_saved_geometry "$class" "$addr_full" && exit 0

                # Nothing remembered and no `always` rule: leave it at the
                # size it asked for. This is the common case for an app being
                # opened for the first time, and it is why a file chooser or a
                # password prompt no longer comes up filling the screen.
                [[ $verdict == always ]] || exit 0

                maximize_checked "$class" "$addr_full"
            ) &
            ;;

        fullscreen*)
            # Format: fullscreen>>0 (exited) / fullscreen>>1 (entered).
            # Only the "entered" edge, and only a client's own MAXIMIZE (a GTK
            # CSD maximize button), gets rerouted to the stateless mod+m
            # maximize. Real fullscreen (compositor mod+Shift+m, or an app's
            # F11) is left as-is.
            state=${line#fullscreen>>}
            [[ $state == 1 ]] || continue

            (
                # No address in the event; the window that changed state is the
                # focused one (the user clicked its own maximize button).
                aw=$(hyprctl -j activewindow 2>/dev/null)
                addr=$(jq -r '.address // empty' <<<"$aw")
                [[ -z $addr || $addr == null ]] && exit 0

                # eFullscreenMode: 0 none, 1 maximized, 2 fullscreen. Check both
                # the client-requested and effective fields so the app maximize
                # is caught however Hyprland records it — but never touch a real
                # fullscreen (mode 2).
                fc=$(jq -r '.fullscreenClient // 0' <<<"$aw")
                fe=$(jq -r '.fullscreen // 0'       <<<"$aw")
                [[ $fc == 2 || $fe == 2 ]] && exit 0     # real fullscreen -> leave
                [[ $fc == 1 || $fe == 1 ]] || exit 0     # not a maximize   -> leave

                # Don't fight the openwindow branch over a self-maximize-on-open.
                [[ -e $grace_dir/$addr ]] && exit 0

                # Drop the native maximize state, then apply the custom,
                # stateless work-area maximize + stripped chrome (== mod+m).
                # Dispatching state 0 fires fullscreen>>0, which this branch
                # ignores, so there's no feedback loop.
                hyprctl dispatch fullscreenstate "0 0,address:$addr" >/dev/null
                sleep 0.05
                hypr_set_max "$addr"
            ) &
            ;;

        movewindow'>>'*)
            # Format: movewindow>>ADDRESS,WORKSPACENAME. The pattern spells out
            # `>>` so movewindowv2, which repeats every one of these, doesn't
            # run the whole thing a second time.
            #
            # Fires for every workspace change; only a change of SCREEN can do
            # anything here, which is what the size tests below decide.
            #
            # A handler and not a wrapper around the mod+Ctrl+Shift+h/j/k/l
            # binds because Hyprland posts this from the one function that
            # reassigns a window's workspace — so a window dragged across the
            # monitor boundary arrives here too, and behaves the same.
            addr_full="0x${line#movewindow>>}"
            addr_full=${addr_full%%,*}

            (
                client=$(hyprctl -j clients 2>/dev/null \
                    | jq -c --arg a "$addr_full" '.[]? | select(.address == $a)' 2>/dev/null)
                [[ -z $client || $client == null ]] && exit 0

                # Floating only, and never a real fullscreen: a tiled window's
                # size belongs to the layout, which re-tiles it on the new
                # screen anyway, and fullscreen is a state Hyprland re-applies
                # per monitor by itself. Both would only be fought here.
                [[ $(jq -r '.floating'   <<<"$client") == true ]] || exit 0
                [[ $(jq -r '.fullscreen' <<<"$client") == 0    ]] || exit 0

                w=$(jq -r '.size[0]'  <<<"$client")
                h=$(jq -r '.size[1]'  <<<"$client")
                x=$(jq -r '.at[0]'    <<<"$client")
                y=$(jq -r '.at[1]'    <<<"$client")
                mon_id=$(jq -r '.monitor' <<<"$client")
                [[ $mon_id =~ ^[0-9]+$ ]] || exit 0   # not on a screen at all

                # `.monitor` is the DESTINATION already: querying clients on the
                # event itself reports the new screen (verified), so there is
                # nothing to wait for and no address->monitor map to keep.
                hypr_work_area "$mon_id" || exit 0
                here=$WORK_MON
                dest_w=$WORK_W dest_h=$WORK_H dest_x=$WORK_X dest_y=$WORK_Y

                # Already the right size for the screen it is on — maximized
                # here, or snapped to a half or quarter of here. That covers
                # every move that stayed on one monitor, and every move between
                # two screens that happen to have the same work area.
                hypr_fills_work_area "$w" "$h" && exit 0
                hypr_snap_axes "$w" "$h" && exit 0

                # Wearing a rectangle of some OTHER screen, so that is what it
                # was until a moment ago: redo it for this one. hypr_set_max and
                # hypr_set_snap both re-measure here and restore the matching
                # chrome, which the window is still carrying.
                while read -r id; do
                    hypr_work_area "$id" || continue
                    [[ $WORK_MON == "$here" ]] && continue

                    if hypr_fills_work_area "$w" "$h"; then
                        hypr_set_max "$addr_full"
                        break
                    fi

                    # A snap's SIZE says which axis was halved; which SIDE of
                    # that axis it was on has to come from where the window
                    # sits, because a left and a right half are the same
                    # rectangle. Hyprland carries a floating window across at
                    # the same offset INTO the monitor and clamps it to fit when
                    # the new screen is smaller (measured: a right half off the
                    # 1920 Dell lands hard against the laptop's right edge), so
                    # the centre is compared against the midline of whichever
                    # screen is smaller on that axis — the source's when the
                    # offset survived intact, this one's when the clamp is what
                    # positioned it, and those are the same test.
                    hypr_snap_axes "$w" "$h" || continue
                    horiz='' vert=''
                    if [[ $SNAP_AXIS_X == half ]]; then
                        near_side $(( x + w / 2 - dest_x )) "$WORK_W" "$dest_w" \
                            && horiz=left || horiz=right
                    fi
                    if [[ $SNAP_AXIS_Y == half ]]; then
                        near_side $(( y + h / 2 - dest_y )) "$WORK_H" "$dest_h" \
                            && vert=top || vert=bottom
                    fi
                    hypr_set_snap "$addr_full" "$horiz" "$vert"
                    break
                done < <(hyprctl -j monitors 2>/dev/null | jq -r '.[].id')
            ) &
            ;;

        monitoradded*|monitorremoved*)
            # Prefix match, so the v2 spellings are covered too. Hyprland is
            # about to move workspaces between outputs and resize everything on
            # them; arm the settle window so none of that is mistaken for a
            # decision of yours. See settle_file.
            touch "$settle_file"
            ;;

        closewindow*)
            # Format: closewindow>>ADDRESS
            addr=${line#closewindow>>}
            addr_full="0x${addr}"

            # Try a live query first — closewindow often fires before
            # Hyprland drops the window from its client list, giving us
            # the up-to-the-moment size (catches manual resizes done
            # seconds before close). The cache is only the fallback for
            # the rare race where the window's already gone.
            client=$(hyprctl -j clients 2>/dev/null | jq -c --arg a "$addr_full" \
                '.[]? | select(.address == $a)' 2>/dev/null)

            if [[ -z $client || $client == "null" ]]; then
                [[ -f $cache_file ]] || continue
                client=$(jq -c --arg a "$addr_full" \
                    '.[]? | select(.address == $a)' "$cache_file" 2>/dev/null)
                [[ -z $client || $client == "null" ]] && continue
            fi

            class=$(echo "$client" | jq -r '.class')

            [[ $(hypr_policy_for "$class") == never ]] && continue

            # A window closing seconds after a monitor event was very likely
            # just relocated and resized by Hyprland, so its geometry says
            # nothing about where you wanted it. Keeping what was already
            # remembered is the safer answer.
            monitors_settling && continue

            # The same gate as the open path, and for the same reason: what a
            # dialog was doing when you dismissed it is not what the app's real
            # window should come back as. Closing the last window of a class is
            # the moment its geometry is worth keeping — and mod+Alt+Shift+m
            # records one deliberately when it isn't the last.
            alone_of_class "$class" "$addr_full" || continue

            w=$(echo "$client" | jq -r '.size[0]')
            h=$(echo "$client" | jq -r '.size[1]')
            x=$(echo "$client" | jq -r '.at[0]')
            y=$(echo "$client" | jq -r '.at[1]')
            mon_id=$(echo "$client" | jq -r '.monitor')

            hypr_save_geometry "$class" "$w" "$h" "$x" "$y" "$mon_id"
            ;;
    esac
done
