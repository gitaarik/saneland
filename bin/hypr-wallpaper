#!/usr/bin/bash
#
# Pick a random wallpaper from a theme's pool and crossfade to it via awww.
#
# Pools live in ~/.config/hypr/wallpapers/{dark,dusk,dawn,light}/ and may hold
# any number of images — drop files in or delete them, no config to touch. The
# theme picks the pool and the sun can shift it one rung; see below. Called by
# hypr-wallpaper-rotate (the timer loop, and its hot-plug watcher) and by
# ~/.local/bin/theme (to repaint immediately on a dark/light switch instead of
# waiting for the next tick).
#
# Why awww and not hyprpaper? hyprpaper has no transition support of any kind —
# every change is a single-frame repaint, which reads as a flash on each
# rotation tick. awww (the renamed swww, ≥0.12) crossfades. Tune the fade here;
# `awww img --help` lists the other transition types (wipe, grow, wave, …):
TRANSITION=(--transition-type fade --transition-duration 1 --transition-fps 60)
#
# Usage:
#   hypr-wallpaper [dark|light]   pick a fresh image (default: ~/.cache/current-theme)
#   hypr-wallpaper repaint        re-apply the CURRENT image, for a screen that
#                                 was connected after the last paint

mode=pick
[[ ${1:-} == repaint ]] && { mode=repaint; shift; }

scheme="${1:-$(cat ~/.cache/current-theme 2>/dev/null || echo dark)}"
pools="$HOME/.config/hypr/wallpapers"
dir="$pools/$scheme"

# Four pools, one brightness ladder:
#
#     dark/  ->  dusk/  ->  dawn/  ->  light/
#
# The theme picks which end you live at and the sun moves you one rung towards
# the middle when it is near the horizon. Which rung is the THEME's to choose,
# not the clock's: the light theme brightens into dawn and the dark theme
# darkens into dusk, whichever end of the day it actually is. So a dark desktop
# at sunrise shows dusk photographs — the ones that sit next to its night set —
# rather than the bright ones a sunrise would otherwise imply.
#
# The theme itself is never touched: dark stays dark at noon if that is what you
# asked for. All that changes is which images are eligible.
#
# dawn/ and dusk/ are optional. Missing or empty, this falls straight back to
# the theme's own pool, which is what every existing setup has — and there is no
# night/ or day/ pool because dark/ and light/ already are those sets.
#
# SANELAND_PHASE overrides the sun, for testing and for anyone who would rather
# pin it.
phase="${SANELAND_PHASE:-$(~/.local/bin/sun-phase 2>/dev/null || echo day)}"
twilight=dusk
[[ $scheme == light ]] && twilight=dawn
pooldir="$dir"
case $phase in
    dawn|dusk)
        if compgen -G "$pools/$twilight/*" >/dev/null 2>&1; then
            pooldir="$pools/$twilight"
        fi
        ;;
esac

# Wait for awww-daemon's socket. At login, monitor + surface setup takes a
# moment before the daemon answers and `awww img` just errors out until then.
# On a theme switch or a rotation tick it's already up, so this breaks on the
# first iteration.
for _ in $(seq 1 40); do
    awww query &>/dev/null && break
    sleep 0.5
done

# The image showing right now. Tracked in a state file rather than parsed from
# `awww query`, which reports the path symlink-resolved (~/.config/hypr -> the
# dotfiles repo) and so wouldn't string-match the ~/-relative paths we hand it
# here. It serves two purposes: don't repeat it on the next pick, and re-apply
# it verbatim on `repaint`.
state="$HOME/.cache/wallpaper-last"
last="$(cat "$state" 2>/dev/null)"

if [[ $mode == repaint && -r "$last" ]]; then
    pick=$last
else
    # -maxdepth 1 so a pool stays the directory you can see: anything you tuck
    # into a subfolder of it is yours, not another rung of the ladder.
    mapfile -t pool < <(find "$pooldir" -maxdepth 1 -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
        2>/dev/null | sort)
    # A phase pool holding only dotfiles or junk would strand us with nothing;
    # fall back rather than leave the screen on whatever was there.
    if (( ${#pool[@]} == 0 )) && [[ $pooldir != "$dir" ]]; then
        mapfile -t pool < <(find "$dir" -maxdepth 1 -type f \
            \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
            2>/dev/null | sort)
    fi
    (( ${#pool[@]} == 0 )) && exit 0

    pick="${pool[RANDOM % ${#pool[@]}]}"
    if (( ${#pool[@]} > 1 )); then
        while [[ "$pick" == "$last" ]]; do
            pick="${pool[RANDOM % ${#pool[@]}]}"
        done
    fi
fi

# No --outputs = every monitor, each fading on its own surface. Note that this
# only reaches the monitors that exist RIGHT NOW: awww-daemon gives a screen
# connected later an empty surface, which is what the `repaint` path is for.
awww img "${TRANSITION[@]}" "$pick" &>/dev/null && echo "$pick" > "$state"
