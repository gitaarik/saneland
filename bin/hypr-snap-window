#!/usr/bin/env bash
#
# Snap the active window to one half of the work area: left, right, top,
# or bottom. Bound to mod+Ctrl+h/l/k/j.
#
# The rectangle itself is hypr_snap_geom in the shared lib, applied by
# hypr_set_snap: work area via hypr_work_area (wlr-randr for precise scale,
# reserved zones subtracted for the eww bar), inset by a border so the border
# renders inside the screen, and the "snap" chrome (2px border, no hyprbars
# title bar) so the result looks like a proper tiled half rather than a free
# float. This script's own job is only to turn a keypress into a side — which
# is also why hypr-max-on-open can redo a snap on another screen without
# going through here.

set -uo pipefail
source "${HOME}/.local/bin/hypr-window-lib.sh"

side=${1:?Usage: $0 left|right|top|bottom}

target=$(hyprctl -j activewindow | jq -r '.address')
[[ -z $target || $target = "null" ]] && exit 0

# Quarter snap: if the previous snap on this same window was a perpendicular
# half (within 1.5s), combine into the matching corner. Otherwise apply a
# normal half snap. State file stored under /tmp, cleared after a quarter so
# subsequent snaps start fresh.
state_file=/tmp/hypr-snap-state.${UID}
now=$(date +%s%N)

horiz=""; vert=""
case "$side" in
    left|right)  horiz=$side ;;
    top|bottom)  vert=$side ;;
    *) echo "Usage: $0 left|right|top|bottom" >&2; exit 1 ;;
esac

if [[ -r $state_file ]]; then
    IFS=$'\t' read -r last_time last_side last_addr < "$state_file" 2>/dev/null || true
    elapsed_ms=$(( (now - ${last_time:-0}) / 1000000 ))
    if (( elapsed_ms < 1500 )) && [[ ${last_addr:-} = "$target" ]]; then
        case "$last_side" in
            left|right) [[ -z $horiz ]] && horiz=$last_side ;;
            top|bottom) [[ -z $vert ]]  && vert=$last_side ;;
        esac
    fi
fi

if [[ -n $horiz && -n $vert ]]; then
    # Quarter: clear state so the next snap starts a new combo.
    : > "$state_file"
else
    # Half: save state for a possible follow-up perpendicular snap.
    printf '%s\t%s\t%s\n' "$now" "$side" "$target" > "$state_file"
fi

# One of horiz/vert is still empty for a half snap, which is exactly how
# hypr_snap_geom spells "the full extent of that axis".
#
# Snaps within the window's OWN monitor, not the focused one — with a second
# output those differ whenever the cursor is elsewhere (see hypr_work_area).
hypr_set_snap "$target" "$horiz" "$vert"
