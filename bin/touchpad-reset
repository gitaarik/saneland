#!/usr/bin/env bash
#
# Reset the touchpad by rebinding its I2C HID driver.
#
# Occasionally the touchpad wakes from suspend with two-finger scroll and tap
# dead, and no kernel error to show for it. Unbinding and rebinding the driver
# makes it re-initialise; it's dead for about a second, then returns as a new
# input device.
#
# This is only a partial fix: seen once, it left two-finger tap still broken,
# with contacts reported as lasting 1s or more (too long to count as a tap).
# Another suspend and wake (closing the lid) fixed both, so try that first.
#
# Usage:
#   touchpad-reset      # asks for the sudo password
set -euo pipefail

dev=$(awk '/^N: Name=.*[Tt]ouchpad/ { found = 1 }
           found && /^S: Sysfs=/    { print; exit }' /proc/bus/input/devices \
        | grep -o 'i2c-[A-Z0-9]*:[0-9A-F]*' || true)

[[ -n $dev ]] || {
    echo "touchpad-reset: no I2C touchpad found" >&2
    exit 1
}

[[ $EUID -eq 0 ]] || exec sudo "$(readlink -f "$0")"

driver=$(readlink -f "/sys/bus/i2c/devices/$dev/driver")

echo "$dev" > "$driver/unbind"
sleep 1
echo "$dev" > "$driver/bind"
